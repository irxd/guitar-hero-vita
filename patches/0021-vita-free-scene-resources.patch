+#if defined(__vita__)
+// Every handle this renderer created lives in one of its caches; textures a
+// replaceTexture swapped out stay (rare: menu screens).
+SceneRenderer::~SceneRenderer() {
+    for (const auto& [key, id] : textures_) renderer_.vitaDeleteTexture(id);
+    for (const auto& [key, dm] : meshes_) {
+        renderer_.vitaDeleteMesh(dm.mesh);
+        for (const DrawMesh::Pass& p : dm.passes) renderer_.vitaDeleteMesh(p.mesh);
+    }
+    for (const auto& [key, id] : particleMeshes_) renderer_.vitaDeleteMesh(id);
+    for (int id : dynamic_) renderer_.vitaDeleteMesh(id);
+    for (const VitaMerged& m : vitaMerged_)
+        for (const VitaChunk& chunk : m.chunks) renderer_.vitaDeleteMesh(chunk.mesh);
+}
+#endif
