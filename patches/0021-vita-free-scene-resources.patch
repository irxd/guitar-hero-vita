+#if defined(__vita__)
+void Renderer::vitaDeleteTexture(int texture) {
+    if (core_ || !context_ || texture <= 0 || size_t(texture) >= textures_.size() || !textures_[size_t(texture)]) return;
+    gl::glDeleteTextures(1, &textures_[size_t(texture)]);
+    textures_[size_t(texture)] = 0;
+}
+
+void Renderer::vitaDeleteMesh(int mesh) {
+    if (core_ || !context_ || mesh <= 0 || size_t(mesh) >= meshes_.size()) return;
+    GpuMesh& m = meshes_[size_t(mesh)];
+    if (m.vbo) gl::glDeleteBuffers(1, &m.vbo);
+    if (m.ibo) gl::glDeleteBuffers(1, &m.ibo);
+    if (m.vao) gl::glDeleteVertexArrays(1, &m.vao);
+    m = GpuMesh{};  // count 0: drawMesh skips it
+}
+#endif
