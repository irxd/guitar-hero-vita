+// The sphere around the vertices' box: never smaller than the mesh.
+void SceneRenderer::vitaBound(DrawMesh& dm, const std::vector<Vertex>& verts) {
+    dm.vitaSphere[3] = -1;
+    if (verts.empty()) return;
+    float lo[3] = {verts[0].x, verts[0].y, verts[0].z}, hi[3] = {lo[0], lo[1], lo[2]};
+    for (const Vertex& v : verts) {
+        const float p[3] = {v.x, v.y, v.z};
+        for (int k = 0; k < 3; ++k) lo[k] = std::min(lo[k], p[k]), hi[k] = std::max(hi[k], p[k]);
+    }
+    float c[3], r2 = 0;
+    for (int k = 0; k < 3; ++k) c[k] = (lo[k] + hi[k]) * 0.5f;
+    for (const Vertex& v : verts) {
+        const float d[3] = {v.x - c[0], v.y - c[1], v.z - c[2]};
+        r2 = std::max(r2, d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+    }
+    if (!std::isfinite(r2)) return;
+    for (int k = 0; k < 3; ++k) dm.vitaSphere[k] = c[k];
+    dm.vitaSphere[3] = std::sqrt(r2) * 1.001f + 1e-4f;  // rounding margin
+}
+
+// The sphere is wholly outside one of the six clip planes, each taken from
+// the mesh's own MVP (so in mesh space: exact for any scale or mirroring).
+bool SceneRenderer::vitaOutside(const DrawMesh& dm, const Mat4& mvp) {
+    static const bool enabled = [] {
+        const char* v = std::getenv("GD01_VITA_CULL");  // args.txt variables are set after SDL copied the environment
+        return !(v && v[0] == '0');
+    }();
+    const float* s = dm.vitaSphere;
+    if (!enabled || s[3] < 0) return false;
+    float row[4][4];  // clip = row . (x, y, z, 1)
+    for (int i = 0; i < 4; ++i)
+        for (int j = 0; j < 4; ++j) row[i][j] = mvp.at(i, j);
+    for (int axis = 0; axis < 3; ++axis)
+        for (float sign : {1.0f, -1.0f}) {
+            float p[4];
+            for (int j = 0; j < 4; ++j) p[j] = row[3][j] + sign * row[axis][j];
+            const float n = std::sqrt(p[0] * p[0] + p[1] * p[1] + p[2] * p[2]);
+            if (p[0] * s[0] + p[1] * s[1] + p[2] * s[2] + p[3] < -s[3] * n) return true;
+        }
+    return false;
+}
