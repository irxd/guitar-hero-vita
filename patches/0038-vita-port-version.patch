@@ -15,6 +15,7 @@
 // Modified by irxd on 2026-11-13: PS Vita: the first screen's fallback name reads GH Vita (drawLogo).
 // Modified by irxd on 2026-11-14: PS Vita: the graphics backend default stays local (upstream's new Vulkan default left out).
 // Modified by irxd on 2026-11-15: PS Vita: Rear Touch Strum setting (off by default).
+// Modified by irxd on 2026-11-15: PS Vita: the title screen shows the port's version (drawVersion).
 #include "app.h"
 
 #include <SDL3/SDL.h>
@@ -1645,7 +1646,13 @@ void App::drawBackendLabel() {
 // size, in white.
 void App::drawVersion() {
     if (!ui_ || movie_ || screen_ != Screen::Menu || ui_->currentScreen() != "main") return;
+#if defined(__vita__)
+    // PS Vita: the port's own version (the gd01 version it is based on is in
+    // ghvita.log and the controller report; both on the title screen were too long).
+    const std::string v = std::string("v") + GHVITA_VERSION;
+#else
     const std::string v = std::string("v") + GD01_VERSION;
+#endif
     ui_->drawText("impactor.font", v, kScreenW - 23 + 2, 17 + 2, 24, {0, 0, 0, 0.6f}, 0x14);  // shadow
     ui_->drawText("impactor.font", v, kScreenW - 23, 17, 24, {1, 1, 1, 1}, 0x14);
 }
