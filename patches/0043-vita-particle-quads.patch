+void Renderer::vitaQuadMesh(int& mesh, const Vertex* v, size_t quads) {
+    const size_t cap = mesh > 0 && size_t(mesh) < vitaQuadCapacity_.size() ? vitaQuadCapacity_[size_t(mesh)] : 0;
+    if (core_ || mesh <= 0 || quads > cap) {
+        // New, or more quads than the index pattern holds: both buffers, the
+        // pattern for twice the quads (fewer regrowths).
+        const size_t newCap = core_ ? quads : std::max<size_t>({quads, cap * 2, 64});
+        std::vector<uint32_t> idx(newCap * 6);
+        for (size_t q = 0; q < newCap; ++q) {
+            const uint32_t b = uint32_t(q * 4);
+            uint32_t* o = &idx[q * 6];
+            o[0] = b, o[1] = b + 1, o[2] = b + 2, o[3] = b, o[4] = b + 2, o[5] = b + 3;
+        }
+        const std::vector<Vertex> verts(v, v + quads * 4);
+        if (mesh > 0) updateMesh(mesh, verts, idx);
+        else mesh = createMesh(verts, idx);
+        if (core_ || mesh <= 0) return;
+        if (vitaQuadCapacity_.size() <= size_t(mesh)) vitaQuadCapacity_.resize(size_t(mesh) + 1, 0);
+        vitaQuadCapacity_[size_t(mesh)] = newCap;
+    } else {
+        GpuMesh& m = meshes_[size_t(mesh)];
+        if (!m.vao) return;  // freed (deleteMesh)
+        gl::glBindVertexArray(m.vao);
+        gl::glBindBuffer(GL_ARRAY_BUFFER, m.vbo);
+        gl::glBufferData(GL_ARRAY_BUFFER, GLsizeiptr(quads * 4 * sizeof(Vertex)), v, GL_STATIC_DRAW);
+    }
+    meshes_[size_t(mesh)].count = static_cast<int>(quads * 6);
+}
+#endif
