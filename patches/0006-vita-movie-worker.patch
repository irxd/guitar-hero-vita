 void App::movieFrame() {
     Movie& m = *movie_;
+#if defined(__vita__)
+    if (m.worker) {
+        // The disc is read here only (GameData shares one file handle): hand
+        // the worker the file's next bytes while it has room.
+        static std::vector<uint8_t> chunk(64 * 1024);
+        for (int i = 0; i < 8 && !m.fedEnd && m.worker->wantBytes() >= chunk.size(); ++i) {
+            const size_t got = data_->readRange(m.path, m.pos, chunk.data(), chunk.size());
+            m.pos += got;
+            if (got) m.worker->feed(chunk.data(), got);
+            if (got < chunk.size()) m.worker->feedEnd(), m.fedEnd = true;
+        }
+        if (const std::string why = m.worker->error(); !why.empty()) {
+            SDL_Log("movie %s: %s", m.path.c_str(), why.c_str());
+            endMovie();
+            return;
+        }
+        if (m.worker->finished()) {
+            endMovie();
+            return;
+        }
+        if (!m.worker->started()) return;
+        if (!m.startNs) m.startNs = SDL_GetTicksNS();
+        const uint64_t target = uint64_t(double(SDL_GetTicksNS() - m.startNs) / 1e9 * PssMovie::kFrameRate);
+        const bool changed = m.worker->take(target, m.frame.rgba, m.frame.width, m.frame.height);
+        if (m.frame.width == 0) return;
+        if (!m.texture) m.texture = renderer_.createTexture(m.frame);
+        else if (changed) renderer_.updateTexture(m.texture, m.frame);
+        float h = kScreenH, w = h * 4.0f / 3.0f;  // the PS2 picture is 4:3: pillarboxed, as below
+        renderer_.image(m.texture, (kScreenW - w) * 0.5f, 0, w, h, {255, 255, 255, 255}, Blend::Opaque);
+        return;
+    }
+#endif
     std::vector<int16_t> pcm;
     if (m.pss->takeAudio(pcm) && m.audio) SDL_PutAudioStreamData(m.audio, pcm.data(), int(pcm.size() * sizeof(int16_t)));
     double elapsed = double(SDL_GetTicksNS() - m.startNs) / 1e9;
