+const SceneRenderer::VitaMerged* SceneRenderer::vitaMergedFor(const std::vector<const DrawMesh*>& pieces) {
+    for (const VitaMerged& m : vitaMerged_)
+        if (m.pieces == pieces) return &m;
+    constexpr size_t kMaxMerged = 48;  // per renderer (pieces shown / hidden make variants); meshes are kept
+    if (vitaMerged_.size() >= kMaxMerged) return nullptr;
+    VitaMerged merged;
+    merged.pieces = pieces;
+    VitaChunk chunk;
+    std::vector<Vertex> verts;
+    std::vector<uint32_t> idx;
+    auto finish = [&] {
+        if (!verts.empty()) {
+            chunk.mesh = renderer_.createMesh(verts, idx);
+            merged.chunks.push_back(std::move(chunk));
+        }
+        chunk = VitaChunk{};
+        verts.clear();
+        idx.clear();
+    };
+    auto same = [](const VitaBone& a, const VitaBone& b) {
+        if (a.obj != b.obj) return false;
+        return !a.obj || (std::memcmp(a.offset.rot.data(), b.offset.rot.data(), sizeof(float) * 9) == 0 &&
+                          std::memcmp(a.offset.pos.data(), b.offset.pos.data(), sizeof(float) * 3) == 0);
+    };
+    for (const DrawMesh* dm : pieces) {
+        const MeshObj& skin = *dm->skin;
+        VitaBone want[4];
+        for (size_t i = 0; i < 4; ++i) {
+            want[i] = VitaBone{nullptr, Xfm{}};
+            if (i >= skin.bones.size() || skin.bones[i].name.empty()) continue;
+            const SceneObject* b = vitaResolve(skin.bones[i].name);
+            if (b && b->transformable()) want[i] = VitaBone{b, skin.bones[i].offset};
+        }
+        auto find = [&](const VitaBone& v) {
+            for (size_t k = 0; k < chunk.bones.size(); ++k)
+                if (same(chunk.bones[k], v)) return int(k);
+            return -1;
+        };
+        int added = 0;
+        for (int i = 0; i < 4; ++i) {
+            bool seen = find(want[i]) >= 0;
+            for (int j = 0; j < i && !seen; ++j) seen = same(want[j], want[i]);
+            if (!seen) ++added;
+        }
+        if (int(chunk.bones.size()) + added > Renderer::kVitaPaletteBones) finish();
+        uint8_t slot[4];
+        for (int i = 0; i < 4; ++i) {
+            int k = find(want[i]);
+            if (k < 0) k = int(chunk.bones.size()), chunk.bones.push_back(want[i]);
+            slot[i] = uint8_t(k);
+        }
+        const uint32_t base = uint32_t(verts.size());
+        for (Vertex v : vertices(*dm)) {
+            v.r = slot[0], v.g = slot[1], v.b = slot[2], v.a = slot[3];
+            verts.push_back(v);
+        }
+        for (uint32_t i : dm->indices) idx.push_back(base + i);
+    }
+    finish();
+    static int logged = 0;
+    if (logged < 12) {
+        ++logged;
+        size_t bones = 0;
+        for (const VitaChunk& c : merged.chunks) bones += c.bones.size();
+        SDL_Log("vita: merged %u character pieces into %u draws (%u palette bones)", unsigned(pieces.size()),
+                unsigned(merged.chunks.size()), unsigned(bones));
+    }
+    vitaMerged_.push_back(std::move(merged));
+    return &vitaMerged_.back();
+}
+
+void SceneRenderer::vitaDrawSingle(const VitaPiece& p) {
+    Renderer::RenderState st = p.st;
+    st.bones = boneMatrices(*p.dm->skin);
+    st.model = vitaIdentity_.m.data();
+    st.lighting = p.lit ? &p.light : nullptr;
+    renderer_.drawMesh(p.dm->mesh, p.mvp.m.data(), st);
+}
+
+void SceneRenderer::vitaFlush() {
+    if (vitaPieces_.empty()) return;
+    std::vector<VitaPiece> pieces;
+    pieces.swap(vitaPieces_);
+    std::vector<char> done(pieces.size(), 0);
+    std::vector<size_t> group;
+    std::vector<const DrawMesh*> dms;
+    for (size_t i = 0; i < pieces.size(); ++i) {
+        if (done[i]) continue;
+        // Consecutive pieces only: a merged mesh draws its triangles in the
+        // pieces' order, so blending gives what separate draws gave.
+        group.assign(1, i);
+        for (size_t j = i + 1; j < pieces.size() && vitaSameDraw(pieces[i], pieces[j]); ++j) group.push_back(j), done[j] = 1;
+        const VitaMerged* merged = nullptr;
+        if (group.size() > 1) {
+            dms.clear();
+            for (size_t k : group) dms.push_back(pieces[k].dm);
+            merged = vitaMergedFor(dms);
+        }
+        if (!merged) {
+            for (size_t k : group) vitaDrawSingle(pieces[k]);
+            continue;
+        }
+        const VitaPiece& p = pieces[i];
+        Renderer::RenderState st = p.st;
+        st.model = vitaIdentity_.m.data();
+        st.lighting = p.lit ? &p.light : nullptr;
+        st.vitaPalette = true;
+        for (const VitaChunk& c : merged->chunks) {
+            for (size_t b = 0; b < c.bones.size(); ++b) {
+                float* dst = vitaPalette_ + b * 16;
+                if (!c.bones[b].obj) {
+                    std::fill_n(dst, 16, 0.0f);
+                    continue;
+                }
+                Xfm x = compose(c.bones[b].offset, c.bones[b].obj->transformable()->world);
+                Mat4 m = Mat4::fromRowXfm(x.rot, x.pos);
+                std::copy_n(m.m.data(), 16, dst);
+            }
+            st.bones = vitaPalette_;
+            st.vitaBoneCount = int(c.bones.size());
+            renderer_.drawMesh(c.mesh, p.mvp.m.data(), st);
+        }
+    }
+}
 #endif
 
