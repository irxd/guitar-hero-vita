+// --- PS Vita: merged character pieces ---------------------------------------
+// A character is ~11 skinned pieces of at most 4 bones each, one draw each
+// (a crowd member: ~33 us of CPU per draw on the Vita). Consecutive pieces
+// that share every draw setting become one mesh (no reordering, so blended
+// pieces are merged too): their vertices concatenated, each
+// vertex's colour bytes holding its 4 indices into the chunk's palette of up
+// to 8 bones (skinned vertices are white; the shader substitutes white).
+// The palette matrices are computed as boneMatrices does, every draw.
+const Lighting* SceneRenderer::vitaLightingFor(const MatObj* mat) {
+    if (vitaLightValid_ && mat == vitaLightMat_ && env_ == vitaLightEnv_) return vitaLightResult_;
+    vitaLightResult_ = lightingFor(mat);
+    vitaLightMat_ = mat, vitaLightEnv_ = env_, vitaLightValid_ = true;
+    return vitaLightResult_;
+}
+
+void SceneRenderer::vitaBeginBatch() {
+    // Only with the bone palette shader, which is experimental and off unless
+    // GD01_VITA_MERGE=1 (vita_platform.cpp applyBonePalette).
+    vitaBatching_ = renderer_.vitaBonePalette();
+    vitaLightValid_ = false;  // a new character draw: lights may have moved
+}
+
+void SceneRenderer::vitaEndBatch() {
+    vitaFlush();
+    vitaBatching_ = false;
+}
+
+bool SceneRenderer::vitaBatchable(const DrawMesh& dm, const Renderer::RenderState& st) {
+    if (!dm.skin || !dm.mesh || !dm.geom || !dm.passes.empty() || st.decal) return false;
+    if (dm.stage && (dm.stage->texgen == 1 || dm.stage->texgen == 4)) return false;  // UV rows baked per piece
+    // Vertices that ever change (a MeshAnim: faces) are never merged.
+    auto [it, added] = vitaRevisions_.try_emplace(&dm, VitaRevision{dm.geom->revision, false});
+    if (!added && it->second.revision != dm.geom->revision) it->second.dynamic = true;
+    return !it->second.dynamic;
+}
+
+bool SceneRenderer::vitaSameDraw(const VitaPiece& a, const VitaPiece& b) {
+    const Renderer::RenderState &x = a.st, &y = b.st;
+    auto eq = [](const float* p, const float* q, int n) { return std::memcmp(p, q, size_t(n) * sizeof(float)) == 0; };
+    if (a.dm->mat != b.dm->mat || !eq(a.mvp.m.data(), b.mvp.m.data(), 16)) return false;
+    if (x.texture != y.texture || x.blend != y.blend || x.depthTest != y.depthTest || x.depthWrite != y.depthWrite ||
+        x.cull != y.cull || x.alphaCutout != y.alphaCutout || x.decal != y.decal || x.mirrored != y.mirrored ||
+        x.useEnviron != y.useEnviron || x.vertAmb != y.vertAmb || x.vertDyn != y.vertDyn || x.fog != y.fog ||
+        x.texgen != y.texgen || x.texDecal != y.texDecal)
+        return false;
+    if (!eq(x.uvOffset, y.uvOffset, 2) || !eq(x.tint, y.tint, 4) || !eq(&x.colorScale, &y.colorScale, 1) ||
+        !eq(&x.fogStart, &y.fogStart, 1) || !eq(&x.fogEnd, &y.fogEnd, 1) || !eq(x.fogColor, y.fogColor, 3) ||
+        !eq(x.texU, y.texU, 9) || !eq(x.texO, y.texO, 2) || !eq(x.eye, y.eye, 3) || !eq(x.camRight, y.camRight, 3) ||
+        !eq(x.camUp, y.camUp, 3))
+        return false;
+    if (a.lit != b.lit) return false;
+    if (!a.lit) return true;
+    const Lighting &l = a.light, &m = b.light;
+    return l.count == m.count && eq(l.ambient, m.ambient, 3) && eq(&l.dir[0][0], &m.dir[0][0], 4 * l.count) &&
+           eq(&l.color[0][0], &m.color[0][0], 4 * l.count);
+}
