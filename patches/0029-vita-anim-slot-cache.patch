+    // Each sampled value's slot, per clip. AnimClip::sample lists a clip's
+    // channels in the same order every call (its own bone lists), so the
+    // per-value slotFor (a hash and a string compare: most of the 3 ms a
+    // song frame spends posing characters, hardware 2026-11-12) runs once per
+    // clip. The values' bone pointers are kept and compared every call, so a
+    // different list (another clip at a reused address) is looked up again.
+    struct ClipSlots {
+        std::vector<const std::string*> bones;
+        std::vector<int> slots;
+    };
+    std::unordered_map<const void*, ClipSlots> clipSlots;
+    const std::vector<int>& slotsFor(const void* clip, const std::vector<AnimClip::Value>& values) {
+        ClipSlots& c = clipSlots[clip];
+        bool same = c.bones.size() == values.size();
+        for (size_t i = 0; same && i < values.size(); ++i) same = c.bones[i] == values[i].bone;
+        if (!same) {
+            c.bones.resize(values.size());
+            c.slots.resize(values.size());
+            for (size_t i = 0; i < values.size(); ++i) c.bones[i] = values[i].bone, c.slots[i] = slotFor(values[i].bone);
+        }
+        return c.slots;
+    }
