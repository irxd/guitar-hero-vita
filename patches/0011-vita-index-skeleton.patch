+// updateWorld's composition, in parents-first order.
+void Character::vitaUpdateWorld(VitaSkeleton& sk) {
+    for (int i : sk.order) {
+        Transformable& t = *sk.xf[size_t(i)];
+        const int p = sk.parent[size_t(i)];
+        if (i == sk.fretSelf) t.world = t.local;
+        else t.world = compose(t.local, p >= 0 ? sk.xf[size_t(p)]->world : placement_);
+    }
+    for (const auto& [copy, owner] : sk.guitarCopies) copy->world = owner->world;
+}
