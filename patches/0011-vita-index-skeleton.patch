+// blendChain's arithmetic, per slot instead of per name.
+void Character::vitaBlendChain(VitaSkeleton& sk, const std::vector<Clip>& clips, const std::vector<Driver>& chain,
+                               float weight) {
+    for (int t : sk.touched) sk.acc[size_t(t)] = {}, sk.inAcc[size_t(t)] = 0;
+    sk.touched.clear();
+    float remaining = weight;
+    for (size_t i = chain.size(); i-- > 0 && remaining > 1e-6f;) {
+        const Driver& d = chain[i];
+        float w = remaining * smooth(d.blend);
+        remaining -= w;
+        if (w <= 0) continue;
+        clips[size_t(d.clip)].clip->sample(d.frame, scratch_);
+        for (const AnimClip::Value& v : scratch_) {
+            const int slot = sk.slotFor(v.bone);
+            if (slot < 0) continue;
+            if (rootMotion_ && sk.slotFacing[size_t(slot)]) continue;  // use_delta: the dummy bone
+            if (!sk.inAcc[size_t(slot)]) sk.inAcc[size_t(slot)] = 1, sk.touched.push_back(slot);
+            VitaSkeleton::Acc& a = sk.acc[size_t(slot)];
+            if (v.kind == AnimClip::Kind::Pos) {
+                for (int k = 0; k < 3; ++k) a.pos[size_t(k)] += w * v.v[size_t(k)];
+                a.wPos += w;
+                continue;
+            }
+            std::array<float, 9> m;
+            Quat q;
+            if (v.kind == AnimClip::Kind::Quat) q = {v.v[0], v.v[1], v.v[2], v.v[3]};
+            else {
+                if (v.kind == AnimClip::Kind::RotX) rotXToRot(v.v[0], m);
+                else if (v.kind == AnimClip::Kind::RotY) rotYToRot(v.v[0], m);
+                else rotZToRot(v.v[0], m);
+                q = rotToQuat(m);
+            }
+            Quat ref = a.wRot == 0 ? rotToQuat(sk.slotXfm[size_t(slot)]->rot) : a.q;
+            float dot = q[0] * ref[0] + q[1] * ref[1] + q[2] * ref[2] + q[3] * ref[3];
+            float sgn = dot < 0 ? -1.0f : 1.0f;
+            for (int k = 0; k < 4; ++k) a.q[size_t(k)] += w * sgn * q[size_t(k)];
+            a.wRot += w;
+        }
+    }
+    for (int t : sk.touched) {
+        const VitaSkeleton::Acc& a = sk.acc[size_t(t)];
+        Xfm& x = *sk.slotXfm[size_t(t)];
+        if (a.wPos > 0)
+            for (int k = 0; k < 3; ++k) x.pos[size_t(k)] = a.pos[size_t(k)] + (1 - a.wPos) * x.pos[size_t(k)];
+        if (a.wRot > 0) {
+            Quat q = a.q;
+            if (a.wRot < 1) {
+                Quat bq = rotToQuat(x.rot);
+                float dot = q[0] * bq[0] + q[1] * bq[1] + q[2] * bq[2] + q[3] * bq[3];
+                float sgn = dot < 0 ? -1.0f : 1.0f;
+                for (int k = 0; k < 4; ++k) q[size_t(k)] += (1 - a.wRot) * sgn * bq[size_t(k)];
+            }
+            float len = std::sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+            if (len > 0) {
+                for (float& c : q) c /= len;
+                quatToRot(q, x.rot);
+            }
+        }
+    }
+}
