+// ---------------------------------------------------------------- PS Vita
+// The skeleton as arrays. Upstream keys every bone by name in std::maps that
+// are searched (and, for the blend accumulator and updateWorld's "done" set,
+// built with a string allocation per bone) every frame; on the Vita's A9 that
+// made a character's poll 2-9 ms, and a song frame polls a dozen characters
+// (guitarist 9 ms, band 7 ms, crowd 17-21 ms; hardware 2026-11-10).
+//
+// Same results: the blend and world update do the same arithmetic in the same
+// order, only the bookkeeping differs. The first kChecks poses of each
+// character run upstream's code as well and compare every bone bit for bit;
+// a difference logs and switches that character back to upstream's code.
+struct Character::VitaSkeleton {
+    static constexpr int kChecks = 8;
+    bool ok = false;
+    bool reference = false;  // running upstream's code for a check
+    int checks = kChecks;
+    // objects_ (owners), in map order.
+    std::vector<Transformable*> xf;
+    std::vector<int> parent;  // index into xf, or -1: under placement_
+    std::vector<int> order;   // parents before children
+    int fretSelf = -1;        // detached bone_fret: world = local
+    Transformable* fret = nullptr;
+    std::vector<std::pair<Transformable*, const Transformable*>> guitarCopies;
+    // buffer_ entries (std::map nodes: stable addresses) and their objects.
+    std::vector<Xfm*> slotXfm;
+    std::vector<Transformable*> slotTarget;
+    std::vector<char> slotFacing;
+    std::map<std::string, int> slotOfName;
+    struct BoneRef {
+        std::string name;
+        int slot;
+    };
+    std::unordered_map<const std::string*, BoneRef> boneSlot;  // a clip's bone name -> slot (-1: not posed)
+    struct Acc {
+        std::array<float, 3> pos{};
+        Quat q{};
+        float wPos = 0, wRot = 0;
+    };
+    std::vector<Acc> acc;
+    std::vector<char> inAcc;
+    std::vector<int> touched;
+    // servos(): foreArm, foreTwist1, foreTwist2, hand, upperArm, upperTwist1, upperTwist2 (L, R).
+    Transformable* servo[2][7] = {};
+
+    int slotFor(const std::string* bone) {
+        auto it = boneSlot.find(bone);
+        if (it != boneSlot.end() && it->second.name == *bone) return it->second.slot;
+        auto s = slotOfName.find(*bone);
+        const int slot = s == slotOfName.end() ? -1 : s->second;
+        boneSlot[bone] = {*bone, slot};
+        return slot;
+    }
+    std::vector<Xfm> slotValues() const {
+        std::vector<Xfm> v;
+        v.reserve(slotXfm.size());
+        for (const Xfm* x : slotXfm) v.push_back(*x);
+        return v;
+    }
+    void setSlotValues(const std::vector<Xfm>& v) {
+        for (size_t i = 0; i < slotXfm.size(); ++i) *slotXfm[i] = v[i];
+    }
+    std::vector<Xfm> worlds() const {
+        std::vector<Xfm> v;
+        v.reserve(xf.size() + guitarCopies.size());
+        for (const Transformable* t : xf) v.push_back(t->world);
+        for (const auto& c : guitarCopies) v.push_back(c.first->world);
+        return v;
+    }
+    static bool same(const std::vector<Xfm>& a, const std::vector<Xfm>& b) {
+        return a.size() == b.size() && std::memcmp(a.data(), b.data(), a.size() * sizeof(Xfm)) == 0;
+    }
+};
+
+Character::VitaSkeleton* Character::vitaSkeleton() {
+    if (!vitaSkel_) {
+        if (buffer_.empty()) return nullptr;
+        vitaSkel_ = std::make_unique<VitaSkeleton>();
+        buildVitaSkeleton(*vitaSkel_);
+        if (!vitaSkel_->ok) SDL_Log("vita: character %s: no index skeleton (upstream path)", model_.c_str());
+    }
+    return vitaSkel_->ok ? vitaSkel_.get() : nullptr;
+}
+
+void Character::buildVitaSkeleton(VitaSkeleton& sk) {
+    std::map<std::string, int> index;
+    for (auto& [name, o] : objects_) {
+        if (!o || !o->transformable()) return;
+        index[name] = int(sk.xf.size());
+        sk.xf.push_back(o->transformable());
+    }
+    const int n = int(sk.xf.size());
+    sk.parent.assign(size_t(n), -1);
+    for (auto& [name, o] : objects_) {
+        const int i = index[name];
+        if (fretDetached_ && name == "bone_fret.mesh") {
+            sk.fretSelf = i;
+            continue;
+        }
+        if (auto p = parent_.find(name); p != parent_.end())
+            if (auto q = index.find(p->second); q != index.end()) sk.parent[size_t(i)] = q->second;
+    }
+    // Parents before children; a cycle (or a chain deeper than upstream's 64)
+    // keeps upstream's code.
+    std::vector<char> state(size_t(n), 0);
+    std::function<bool(int, int)> visit = [&](int i, int depth) {
+        if (state[size_t(i)] == 2) return true;
+        if (state[size_t(i)] == 1 || depth >= 64) return false;
+        state[size_t(i)] = 1;
+        if (sk.parent[size_t(i)] >= 0 && !visit(sk.parent[size_t(i)], depth + 1)) return false;
+        state[size_t(i)] = 2;
+        sk.order.push_back(i);
+        return true;
+    };
+    for (int i = 0; i < n; ++i)
+        if (!visit(i, 0)) return;
+    if (guitar_)
+        for (SceneObject& o : guitar_->objects()) {
+            Transformable* t = o.transformable();
+            if (!t) continue;
+            auto it = objects_.find(o.name);
+            if (it == objects_.end()) return;
+            if (it->second != &o) sk.guitarCopies.push_back({t, it->second->transformable()});
+        }
+    for (auto& [name, x] : buffer_) {
+        auto it = objects_.find(name);
+        if (it == objects_.end()) return;
+        sk.slotOfName[name] = int(sk.slotXfm.size());
+        sk.slotXfm.push_back(&x);
+        sk.slotTarget.push_back(it->second->transformable());
+        sk.slotFacing.push_back(name.rfind("bone_facing", 0) == 0);
+    }
+    sk.acc.resize(sk.slotXfm.size());
+    sk.inAcc.assign(sk.slotXfm.size(), 0);
+    if (auto it = objects_.find("bone_fret.mesh"); it != objects_.end()) sk.fret = it->second->transformable();
+    static const char* const kServoBones[7] = {"foreArm.mesh", "foreTwist1.mesh", "foreTwist2.mesh", "hand.mesh",
+                                               "upperArm.mesh", "upperTwist1.mesh", "upperTwist2.mesh"};
+    for (int side = 0; side < 2; ++side)
+        for (int k = 0; k < 7; ++k) {
+            auto it = objects_.find(std::string("bone_") + (side ? "R" : "L") + "-" + kServoBones[k]);
+            sk.servo[side][k] = it == objects_.end() ? nullptr : it->second->transformable();
+        }
+    sk.ok = true;
+}
