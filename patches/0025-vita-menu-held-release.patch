 void UiSystem::buttonUp(int button, int player) {
+#if defined(__vita__)
+    // PS Vita: a held direction stops repeating whichever player lets go:
+    // binding a player on the Gamepads screen with Left / Right moves the pad
+    // to another player between the press and the release, and the press's
+    // player then repeated it for ever (hardware, 2026-11-12).
+    for (HeldButton& h : held_)
+        if (h.button == button) h = {};
+#else
     if (held_[size_t(player & 1)].button == button) held_[size_t(player & 1)] = {};
+#endif
     if (phase_ != Phase::Idle) return;
     route("button_up", {{"button", Value::integer(button)}, {"player_num", Value::integer(player)}});
 }
