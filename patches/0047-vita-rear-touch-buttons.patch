+
+// The Vita's own pad: SDL's first joystick (id 1; on a PS TV, the first
+// paired controller, which has no rear touchpad anyway). 0: no pad.
+SDL_JoystickID Input::rearPad() const {
+    SDL_JoystickID best = 0;
+    for (const auto& [id, p] : pads_)
+        if (!best || id < best) best = id;
+    return best;
+}
+
+bool Input::rearBound(SDL_JoystickID pad, int button) const {
+    for (const auto& list : bindings("pad:" + std::to_string(pad)))
+        for (const Source& s : list)
+            if (s.kind == Kind::Button && s.index == button) return true;
+    return false;
+}
+
+// The press goes the way of a real button of that pad (Input::handle):
+// capture on the Gamepads screen, then its bindings.
+void Input::rearButton(SDL_JoystickID pad, int button, bool down, uint64_t ts, std::vector<InputEvent>& out) {
+    if (!pads_.count(pad)) return;
+    SDL_Event e;
+    SDL_zero(e);
+    e.type = down ? SDL_EVENT_GAMEPAD_BUTTON_DOWN : SDL_EVENT_GAMEPAD_BUTTON_UP;
+    e.gbutton.timestamp = ts;
+    e.gbutton.which = pad;
+    e.gbutton.button = Uint8(button);
+    e.gbutton.down = down;
+    handle(e, out);
 }
