 void Player::strum(float t) {
     if (std::getenv("GD01_HOPOLOG")) std::fprintf(stderr, "strum at %.1f (held %02x)\n", t, pressed_);
+#if defined(__vita__)
+    // PS Vita: in joypad mode (the Vita pad's default) a fret press is the
+    // hit and the original ignores strums, so the D-pad / L-R strum and Rear
+    // Touch Strum did nothing (hardware, 2026-11-15). Here a strum plays the
+    // held frets again, but only when that hits a note not hit yet: a strum
+    // can help (fast runs of one note or chord) and never costs a miss.
+    if (mode_ != ControllerMode::Guitar && !failed_ && pressed_ != 0 && lastStrumMs_ + kStrumDebounceMs < t) {
+        const int i = nearestGem(t);
+        if (i >= 0 && i >= firstGem_ && !hit_[size_t(i)] && owned(i) && inSlop(chart_.gems[size_t(i)].ms, t)) {
+            const Gem& g = chart_.gems[size_t(i)];
+            const int fret = highestFret(pressed_);
+            if (g.fretCount() == 1 ? lowestFret(g.frets) == fret : chordMatch(g.frets, held_)) {
+                lastStrumMs_ = t;
+                watcherStrum(t, fret, false);
+            }
+        }
+    }
+#endif
     if (mode_ != ControllerMode::Guitar || failed_) return;
     if (lastStrumMs_ + kStrumDebounceMs < t) {
         lastStrumMs_ = t;
