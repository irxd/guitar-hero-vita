+// PS Vita: the scene program again, its fragment shader without the cutout's
+// discard. Used only when every uniform the draws set has the same location
+// in both programs (else: off, logged; the draws keep program_).
+// GHVITA_OPAQUE_PROGRAM=0 (args.txt) turns it off for comparisons.
+void Renderer::initVitaOpaqueProgram() {
+    const char* env = std::getenv("GHVITA_OPAQUE_PROGRAM");
+    if (env && std::atoi(env) == 0) {
+        SDL_Log("vita: opaque scene program off (GHVITA_OPAQUE_PROGRAM=0)");
+        return;
+    }
+    std::string frag = kFragmentShader;
+    const std::string cut = "    if (c.a <= uCutout) discard;\n";
+    const size_t at = frag.find(cut);
+    if (at == std::string::npos) {
+        SDL_Log("vita: opaque scene program: no cutout line in the fragment shader; off");
+        return;
+    }
+    frag.erase(at, cut.size());
+    std::string error;
+    unsigned vs = compile(GL_VERTEX_SHADER, kVertexShader, error);
+    unsigned fs = vs ? compile(GL_FRAGMENT_SHADER, frag.c_str(), error) : 0;
+    if (!fs) {
+        if (vs) gl::glDeleteShader(vs);
+        SDL_Log("vita: opaque scene program: %s; off", error.c_str());
+        return;
+    }
+    unsigned p = gl::glCreateProgram();
+    gl::glAttachShader(p, vs);
+    gl::glAttachShader(p, fs);
+    gl::glLinkProgram(p);
+    gl::glDeleteShader(vs);
+    gl::glDeleteShader(fs);
+    GLint ok = 0;
+    gl::glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        SDL_Log("vita: opaque scene program: link failed; off");
+        gl::glDeleteProgram(p);
+        return;
+    }
+    // Each program's locations, in the order of vitaUseLocations' list
+    // (uCutout is -1 in the opaque one: its writes are no-ops there).
+    static const char* const kNames[kVitaUniforms] = {
+        "uMvp",   "uJitter",   "uTex",   "uUseTex", "uCutout",   "uUvOffset", "uTint",    "uSkin",       "uBones",
+        "uBoneRows", "uLit",   "uMatFlags", "uColorScale", "uFog", "uFogColor", "uModel", "uTexgen",     "uTexU",
+        "uTexO",  "uEye",      "uCamRight", "uCamUp", "uTexDecal", "uAmbient", "uLightCount", "uLightDir", "uLightColor"};
+    for (int i = 0; i < kVitaUniforms; ++i) {
+        vitaLocs_[0][size_t(i)] = gl::glGetUniformLocation(program_, kNames[i]);
+        vitaLocs_[1][size_t(i)] = gl::glGetUniformLocation(p, kNames[i]);
+    }
+    vitaOpaqueProgram_ = p;
+    vitaLocsOpaque_ = false;
+    SDL_Log("vita: opaque scene program on (no discard for draws without the alpha cutout)");
+}
+
+void Renderer::vitaUseLocations(bool opaque) {
+    if (opaque == vitaLocsOpaque_ || !vitaOpaqueProgram_) return;
+    int* const members[kVitaUniforms] = {&uMvp_,        &uJitter_,   &uTex_,      &uUseTex_,      &uCutout_,     &uUvOffset_,
+                                         &uTint_,       &uSkin_,     &uBones_,    &uBoneRows_,    &uLit_,        &uMatFlags_,
+                                         &uColorScale_, &uFog_,      &uFogColor_, &uModel_,       &uTexgen_,     &uTexU_,
+                                         &uTexO_,       &uEye_,      &uCamRight_, &uCamUp_,       &uTexDecal_,   &uAmbient_,
+                                         &uLightCount_, &uLightDir_, &uLightColor_};
+    const auto& locs = vitaLocs_[opaque ? 1 : 0];
+    for (int i = 0; i < kVitaUniforms; ++i) *members[i] = locs[size_t(i)];
+    vitaLocsOpaque_ = opaque;
+}
