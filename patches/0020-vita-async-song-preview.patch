 void RandomFile::read(uint64_t offset, void* dst, size_t size) {
+#if defined(__vita__)
+    // PS Vita: newlib's fread reached the memory card in small pieces, ~4 MB/s
+    // (a 19 MB song in 5 s, hardware 2026-11-11). sceIoPread reads at an
+    // offset in one call (no shared file position: safe from the song
+    // preview thread too).
+    if (vitaFd_ >= 0) {
+        if (offset + size > size_) throw std::runtime_error("read beyond end of file");
+        auto* out = static_cast<uint8_t*>(dst);
+        constexpr size_t kPiece = 4 * 1024 * 1024;
+        for (size_t done = 0; done < size;) {
+            const size_t want = std::min(kPiece, size - done);
+            const int got = sceIoPread(vitaFd_, out + done, SceSize(want), SceOff(offset + done));
+            if (got <= 0) throw std::runtime_error("read beyond end of file");
+            done += size_t(got);
+        }
+        return;
+    }
+#endif
     if (offset + size > size_ || seek64(f_, offset) != 0 || std::fread(dst, 1, size, f_) != size)
         throw std::runtime_error("read beyond end of file");
 }
