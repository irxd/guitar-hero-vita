+#if defined(__vita__)
+VgsStream::VgsStream(const std::function<size_t(uint64_t, uint8_t*, size_t)>& read, double startMs, double endMs) {
+    Bytes header(kHeaderSize);
+    if (read(0, header.data(), header.size()) != header.size()) throw std::runtime_error("VGS file cut short");
+    ByteReader r(header);
+    if (r.str(4) != "VgS!") throw std::runtime_error("not a VGS file");
+    if (r.u32le() != 2) throw std::runtime_error("unsupported VGS version");
+    uint64_t total = 0;  // blocks of the longest channel
+    for (int i = 0; i < 15; ++i) {
+        uint32_t rate = r.u32le(), blocks = r.u32le();
+        if (rate == 0) break;
+        if (channels_.empty()) sampleRate_ = static_cast<int>(rate);
+        else if (static_cast<int>(rate) != sampleRate_) throw std::runtime_error("VGS channels differ in sample rate");
+        channels_.emplace_back();
+        total = std::max<uint64_t>(total, blocks);
+    }
+    if (channels_.empty()) throw std::runtime_error("VGS file has no channels");
+    lengthFrames_ = total * 28;
+    const size_t n = channels_.size();
+    const double framesPerMs = sampleRate_ / 1000.0;
+    const uint64_t first = std::min<uint64_t>(uint64_t(std::max(0.0, startMs) * framesPerMs) / 28, total);
+    const uint64_t end = endMs > 0 ? std::min<uint64_t>(uint64_t(endMs * framesPerMs) / 28 + 1, total) : total;
+    vitaFirstBlock_ = static_cast<size_t>(first);
+    data_.resize(static_cast<size_t>(std::max(end, first) - first) * n * kBlockSize);
+    // In pieces of 256 KB (the reads are positional: the main thread may
+    // read the disc image at the same time).
+    constexpr size_t kPiece = 256 * 1024;
+    size_t got = 0;
+    while (got < data_.size()) {
+        const size_t want = std::min(kPiece, data_.size() - got);
+        const size_t k = read(kHeaderSize + first * n * kBlockSize + got, data_.data() + got, want);
+        got += k;
+        if (k < want) break;
+    }
+    data_.resize(got - got % kBlockSize);
+    // Each block by its channel ID, as the full-file constructor: the song
+    // files end with a short uneven round (channels 0 and 1 one block
+    // longer), which only the last blocks of a window can reach.
+    for (size_t off = 0; off < data_.size(); off += kBlockSize) {
+        const size_t ch = data_[off + 1] & 0x7F;
+        if (ch < n) channels_[ch].blocks.push_back(static_cast<uint32_t>(off));
+    }
+}
+#endif
